# ==============================================================================
# AETHER KICKS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit .env files to Git.
# ==============================================================================

# Application Environment
NODE_ENV=production
APP_URL=https://aether-kicks.vercel.app
PORT=3000

# Cryptographic Master Signing Secrets (Min. 32-byte high-entropy string)
AUTH_JWT_SECRET=replace_with_64_char_crypto_random_hmac_secret_key_hex
SESSION_COOKIE_SECRET=replace_with_32_char_aes_cookie_encryption_key

# Relational Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://aether_db_user:SUPER_STRONG_PASSWORD@db.aetherkicks.com:5432/aether_vault?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Master Administrative Provisioning (First Boot Only)
INITIAL_ADMIN_EMAIL=admin@aetherkicks.com
INITIAL_ADMIN_PASSWORD=replace_with_secure_initial_admin_password
INITIAL_ADMIN_ROLE="Root Superadmin"

# Rate Limiting & Brute Force Defense (Redis / Upstash)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=600

# Payment Gateway (Mocked locally, real keys for production)
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Cloud Storage / Assets CDN
STORAGE_BUCKET_NAME=aether-vault-assets
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
